#!/usr/bin/env python
# -*- coding: utf-8 -*-
# Copyright (C) 2021 Toyota Motor Corporation

from geometry_msgs.msg import Pose
import rospy
from sensor_msgs.msg import PointCloud2
import sensor_msgs.point_cloud2 as pc2
from tmc_geometric_shapes_msgs.msg import Shape
from tmc_manipulation_msgs.msg import CollisionObject


POINT_CLOUD_TOPIC = '/voxel_grid/output'


class PointCloudToCollisionObject(object):
    def __init__(self):
        self._sphere_radius = rospy.get_param('~sphere_radius', 0.01)
        pub_rate = rospy.get_param('~publish_rate', 10)
        self._rate = rospy.Rate(pub_rate)
        rospy.Subscriber(POINT_CLOUD_TOPIC,
                         PointCloud2, callback=self._pointcloud_cb)
        self._pub = rospy.Publisher('/known_object', CollisionObject,
                                    queue_size=1)
        self._pc = None

    def run(self):
        while not rospy.is_shutdown():
            self._rate.sleep()
            if self._pc is None:
                continue
            self._pub.publish(self.convert())

    def convert(self):
        collision_object = CollisionObject()
        collision_object.header.frame_id = self._frame_id
        collision_object.id.object_id = 0
        collision_object.id.name = 'point_cloud_object'
        shape = Shape()
        shape.type = Shape.SPHERE
        shape.dimensions.append(self._sphere_radius)
        for p in self._pc:
            collision_object.shapes.append(shape)
            pose = Pose()
            pose.position.x = p[0]
            pose.position.y = p[1]
            pose.position.z = p[2]
            pose.orientation.w = 1.0
            collision_object.poses.append(pose)

        return collision_object

    def _pointcloud_cb(self, msg):
        self._frame_id = msg.header.frame_id
        self._pc = pc2.read_points(msg, skip_nans=True,
                                   field_names=("x", "y", "z"))


if __name__ == '__main__':
    rospy.init_node('point_cloud_to_collision_object')
    n = PointCloudToCollisionObject()
    n.run()
    rospy.spin()
